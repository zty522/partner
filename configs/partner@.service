[Unit]
Description=Partner Instance %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PARTNER_INSTANCE_ID=%i
Environment=PARTNER_WORKSPACE=%h/.partner/instances/%i
ExecStart=%h/.partner/instances/%i/start.sh
Restart=on-failure
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
