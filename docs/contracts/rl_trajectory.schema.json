{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "partner/rl_trajectory.schema.json",
  "title": "RLTrajectoryV2",
  "type": "object",
  "required": ["schema_version", "trajectory_id", "campaign_id", "work_item_id", "project_id", "instance_id", "kind", "state", "action", "outcome", "reward", "reward_components", "policy_eligible", "created_at"],
  "properties": {
    "schema_version": {"const": 2},
    "trajectory_id": {"type": "string", "minLength": 1},
    "campaign_id": {"type": "string", "minLength": 1},
    "work_item_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "instance_id": {"pattern": "^0[1-5]$"},
    "kind": {"type": "string"},
    "state": {"type": "object"},
    "action": {
      "type": "object",
      "required": ["action_key", "event_types", "strategy_id", "policy_decision", "policy_arm"],
      "properties": {
        "action_key": {"type": "string"}, "event_types": {"type": "array", "items": {"type": "string"}},
        "strategy_id": {"type": "string"}, "policy_decision": {"type": "string"},
        "policy_arm": {"enum": ["", "baseline", "candidate", "production"]}
      },
      "additionalProperties": false
    },
    "outcome": {
      "type": "object",
      "required": ["status", "artifacts", "evidence", "outcome_fingerprint", "monitor_only", "business_progress", "novel_evidence", "handoff_consumed"]
    },
    "reward": {"type": "number", "minimum": -1, "maximum": 1},
    "reward_components": {"type": "object", "additionalProperties": {"type": "number"}},
    "policy_eligible": {"type": "boolean"},
    "created_at": {"type": "string"}
  },
  "additionalProperties": false
}
