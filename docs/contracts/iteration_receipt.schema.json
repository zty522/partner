{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "partner/iteration_receipt.schema.json",
  "title": "IterationReceipt",
  "type": "object",
  "required": ["receipt_id", "project_id", "iteration", "goal", "inputs", "actions_executed", "artifacts", "findings", "next_actions", "delivery_confirmed", "created_at"],
  "properties": {
    "receipt_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "iteration": {"type": "integer", "minimum": 1},
    "goal": {"type": "string", "minLength": 1},
    "inputs": {"type": "array", "items": {"type": "string"}},
    "actions_executed": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "artifacts": {"type": "array", "items": {"type": "string"}},
    "findings": {"type": "array", "items": {"type": "string"}},
    "unresolved_questions": {"type": "array", "items": {"type": "string"}},
    "next_actions": {"type": "array", "items": {"$ref": "next_action.schema.json"}},
    "stop_reason": {"type": "string"},
    "delivery_confirmed": {"type": "boolean"},
    "created_at": {"type": "string"}
  },
  "additionalProperties": false
}
