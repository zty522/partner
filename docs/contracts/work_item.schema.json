{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "work_item.schema.json",
  "title": "Campaign WorkItem",
  "type": "object",
  "required": ["work_item_id", "campaign_id", "instance_id", "project_id", "kind", "title", "instruction", "status", "priority", "attempt", "max_attempts", "requires_artifact", "requires_delivery", "autonomy", "evidence", "artifacts", "event_types", "created_at", "updated_at"],
  "properties": {
    "work_item_id": {"type": "string", "minLength": 1},
    "campaign_id": {"type": "string", "minLength": 1},
    "instance_id": {"enum": ["01", "02", "03", "04", "05"]},
    "project_id": {"type": "string", "minLength": 1},
    "kind": {"enum": ["project_iteration", "evolution_experiment", "audit", "report"]},
    "title": {"type": "string", "minLength": 1},
    "instruction": {"type": "string", "minLength": 1},
    "status": {"enum": ["proposed", "leased", "queued", "running", "completed", "failed", "blocked", "cancelled"]},
    "priority": {"type": "integer", "minimum": 0, "maximum": 100},
    "attempt": {"type": "integer", "minimum": 0},
    "max_attempts": {"type": "integer", "minimum": 1},
    "task_id": {"type": "string"},
    "lease_id": {"type": "string"},
    "source_action_id": {"type": "string"},
    "source_issue_id": {"type": "string"},
    "requires_artifact": {"type": "boolean"},
    "requires_delivery": {"type": "boolean"},
    "autonomy": {"enum": ["safe", "human_required", "forbidden"]},
    "blocked_reason": {"type": "string"},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "artifacts": {"type": "array", "items": {"type": "string"}},
    "event_types": {"type": "array", "items": {"type": "string"}},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
