{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "partner/issue_record.schema.json",
  "title": "IssueRecord",
  "type": "object",
  "required": ["issue_id", "summary", "category", "severity", "evidence", "status", "created_at"],
  "properties": {
    "issue_id": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "category": {"enum": ["context", "planning", "event", "environment", "verification", "delivery", "scheduling", "data", "model", "unknown"]},
    "severity": {"enum": ["low", "medium", "high", "critical"]},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "instance_id": {"type": "string"},
    "project_id": {"type": "string"},
    "status": {"enum": ["open", "investigating", "candidate", "resolved", "wont_fix"]},
    "occurrences": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"}
  },
  "additionalProperties": false
}
