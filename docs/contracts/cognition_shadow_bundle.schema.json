{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "partner/cognition_shadow_bundle.schema.json",
  "title": "PartnerCognitionShadowBundle",
  "type": "object",
  "required": [
    "schema_version", "kind", "project_id", "cognition_episode_id",
    "partner_instance_id", "partner_task_id", "source_episode_ids", "ledger",
    "reduced_state", "candidate_registration_allowed", "production_mutation_allowed",
    "manual_stable_override", "bundle_digest"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "partner_cognition_shadow"},
    "project_id": {"type": "string", "minLength": 1},
    "cognition_episode_id": {"type": "string", "minLength": 1},
    "partner_instance_id": {"pattern": "^0[1-5]$"},
    "partner_task_id": {"type": "string", "minLength": 1},
    "source_episode_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^episode_"}
    },
    "ledger": {
      "type": "object",
      "required": ["sha256", "head_hash", "event_count"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "head_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "event_count": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "reduced_state": {"type": "object"},
    "candidate_registration_allowed": {"const": false},
    "production_mutation_allowed": {"const": false},
    "manual_stable_override": {"const": false},
    "bundle_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
