{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "partner/context_selection.schema.json",
  "title": "ContextSelection",
  "type": "object",
  "required": ["selection_id", "query", "selected", "budget_chars", "used_chars", "created_at"],
  "properties": {
    "selection_id": {"type": "string", "minLength": 1},
    "query": {"type": "string"},
    "instance_id": {"type": "string"},
    "project_id": {"type": "string"},
    "selected": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["document_id", "path", "tier", "reason", "chars"],
        "properties": {
          "document_id": {"type": "string"},
          "path": {"type": "string"},
          "tier": {"enum": ["L0", "L1", "L2", "L3", "L4"]},
          "reason": {"type": "string"},
          "chars": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "budget_chars": {"type": "integer", "minimum": 1},
    "used_chars": {"type": "integer", "minimum": 0},
    "created_at": {"type": "string"}
  },
  "additionalProperties": false
}
