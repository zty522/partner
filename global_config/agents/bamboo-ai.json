{
  "name": "bamboo-ai",
  "version": "1.0.0",
  "description": "BambooAI — multi-agent data science framework for data analysis, visualization, statistical analysis, and machine learning",
  "capabilities": [
    "data_analysis",
    "data_visualization",
    "statistical_analysis",
    "machine_learning"
  ],
  "input_formats": ["csv", "json", "xlsx", "parquet", "txt", "html"],
  "output_formats": ["json", "csv", "html", "png", "pdf", "txt"],
  "endpoint_type": "cli",
  "endpoint_config": {
    "command": "bamboo-ai",
    "args": ["--input", "{input}", "--output", "{output}"],
    "category": "specialized"
  },
  "timeout": 300,
  "health_check_cmd": "python -m bamboo_ai --version",
  "notes": "May need pip install bamboo-ai"
}
