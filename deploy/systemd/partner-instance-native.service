[Unit]
Description=Partner instance-native event runtime
After=default.target network-online.target

[Service]
Type=simple
WorkingDirectory=/mnt/e/work/partner
ExecStart=/home/os/miniconda3/bin/python /mnt/e/work/partner/scripts/run_instance_native_runtime.py --workspace /mnt/e/work/partner_workspace --watchdog-seconds 30
Restart=on-failure
RestartSec=10
TimeoutStopSec=45

[Install]
WantedBy=default.target
