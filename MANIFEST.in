# Include essential files
include LICENSE
include README.md
include CHANGELOG.md
include release_v0.7.0.md

# Include package data (templates, configs, etc.)
recursive-include partner *.json

# Exclude test files from distribution
recursive-exclude tests *
recursive-exclude partner/tests *

# Exclude development/CI files
exclude .gitignore
exclude demo.py
exclude run_cycle.py

# Exclude build artifacts
recursive-exclude * __pycache__
recursive-exclude * *.py[cod]
recursive-exclude * *.so
recursive-exclude * *.egg-info
prune partner_research.egg-info
prune .pytest_cache
prune events
prune docs
prune scripts
