# World Model Configuration (AETHER GPU backend)
# Generated by: partner world-model configure
# Mode: aether_only — calls AETHER on remote GPU, downloads generated video

world_model:
  enabled: true
  mode: aether_only                # aether_only | disabled
  endpoint: "http://localhost:8100" # World Model Server (local WSL)
  timeout: 120                      # Request timeout in seconds

  # AETHER backend (remote GPU)
  aether:
    endpoint: "http://localhost:8080"  # AETHER API via SSH tunnel
    timeout: 120                       # AETHER inference timeout

  # Output directory (videos + generation logs are saved here)
  output_dir: ""  # Defaults to {workspace}/world_model_outputs/
