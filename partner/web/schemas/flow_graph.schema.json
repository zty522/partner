{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "partner://schemas/flow_graph.schema.json",
  "title": "Partner runtime Event/Flow graph",
  "type": "object",
  "required": ["schema_version", "source_job_id", "flows", "nodes", "edges", "counts"],
  "properties": {
    "schema_version": {"const": 1},
    "source_job_id": {"type": "string", "minLength": 1},
    "flows": {"type": "array", "items": {"type": "object", "required": ["flow_id", "flow_type", "status"]}},
    "nodes": {"type": "array", "items": {"type": "object", "required": ["id", "flow_id", "node_id", "event_type", "status"]}},
    "edges": {"type": "array", "items": {"type": "object", "required": ["from", "to", "kind"]}},
    "counts": {
      "type": "object",
      "required": ["flows", "nodes", "edges"],
      "properties": {
        "flows": {"type": "integer", "minimum": 0},
        "nodes": {"type": "integer", "minimum": 0},
        "edges": {"type": "integer", "minimum": 0}
      }
    }
  }
}
