{
  "manifest_version": "1.0.0",
  "name": "seaborn",
  "description": "Statistical data visualization",
  "version": "latest",
  "category": "visualization",
  "domains": [
    "bioinformatics"
  ],
  "install": {
    "command": "pip install seaborn",
    "requires_sudo": false,
    "dependencies": []
  },
  "test": {
    "command": "python -c 'import seaborn; print(\"OK\")'",
    "expected_output": null
  },
  "capabilities": {
    "actions": [
      "run_seaborn",
      "analyze_with_seaborn"
    ],
    "input_formats": [
      "fasta",
      "fastq",
      "bam",
      "vcf",
      "gff"
    ],
    "output_formats": [
      "tsv",
      "csv",
      "json",
      "html"
    ]
  },
  "execution": {
    "parallel_safe": true,
    "timeout": 3600,
    "memory_gb": 4
  },
  "config": {
    "threads": {
      "type": "int",
      "default": 4
    },
    "verbose": {
      "type": "bool",
      "default": false
    }
  }
}