{
  "manifest_version": "1.0.0",
  "name": "ansible_agent",
  "description": "Ansible infrastructure automation agent",
  "version": "latest",
  "category": "automation",
  "domains": [
    "ai_agents",
    "automation"
  ],
  "install": {
    "command": "pip install ansible",
    "requires_sudo": false,
    "dependencies": []
  },
  "test": {
    "command": "which ansible 2>/dev/null && echo OK || echo not_found",
    "expected_output": "OK"
  },
  "capabilities": {
    "actions": [
      "run_ansible_agent",
      "deploy_ansible_agent"
    ],
    "input_formats": [
      "text",
      "json",
      "yaml"
    ],
    "output_formats": [
      "text",
      "json",
      "markdown"
    ]
  },
  "execution": {
    "parallel_safe": true,
    "timeout": 300,
    "memory_gb": 2
  },
  "config": {
    "model": {
      "type": "str",
      "default": "gpt-4o"
    },
    "temperature": {
      "type": "float",
      "default": 0.7
    }
  }
}