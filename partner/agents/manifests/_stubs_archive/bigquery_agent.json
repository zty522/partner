{
  "manifest_version": "1.0.0",
  "name": "bigquery_agent",
  "description": "Google BigQuery analytics agent",
  "version": "latest",
  "category": "data_agents",
  "domains": [
    "ai_agents",
    "data agents"
  ],
  "install": {
    "command": "pip install google-cloud-bigquery",
    "requires_sudo": false,
    "dependencies": []
  },
  "test": {
    "command": "python -c 'import google.cloud.bigquery; print(\"OK\")'",
    "expected_output": "OK"
  },
  "capabilities": {
    "actions": [
      "run_bigquery_agent",
      "deploy_bigquery_agent"
    ],
    "input_formats": [
      "text",
      "json",
      "yaml"
    ],
    "output_formats": [
      "text",
      "json",
      "markdown"
    ]
  },
  "execution": {
    "parallel_safe": true,
    "timeout": 300,
    "memory_gb": 2
  },
  "config": {
    "model": {
      "type": "str",
      "default": "gpt-4o"
    },
    "temperature": {
      "type": "float",
      "default": 0.7
    }
  }
}