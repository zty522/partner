{
  "manifest_version": "1.0.0",
  "name": "browser_use",
  "description": "Browser automation agent for web tasks",
  "version": "latest",
  "category": "web_agents",
  "domains": [
    "ai_agents",
    "web agents"
  ],
  "install": {
    "command": "pip install browser-use",
    "requires_sudo": false,
    "dependencies": []
  },
  "test": {
    "command": "python -c 'import browser_use; print(\"OK\")'",
    "expected_output": "OK"
  },
  "capabilities": {
    "actions": [
      "run_browser_use",
      "deploy_browser_use"
    ],
    "input_formats": [
      "text",
      "json",
      "yaml"
    ],
    "output_formats": [
      "text",
      "json",
      "markdown"
    ]
  },
  "execution": {
    "parallel_safe": true,
    "timeout": 300,
    "memory_gb": 2
  },
  "config": {
    "model": {
      "type": "str",
      "default": "gpt-4o"
    },
    "temperature": {
      "type": "float",
      "default": 0.7
    }
  }
}