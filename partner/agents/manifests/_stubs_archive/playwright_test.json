{
  "manifest_version": "1.0.0",
  "name": "playwright_test",
  "description": "Playwright end-to-end test agent",
  "version": "latest",
  "category": "testing",
  "domains": [
    "ai_agents",
    "testing"
  ],
  "install": {
    "command": "pip install pytest-playwright",
    "requires_sudo": false,
    "dependencies": []
  },
  "test": {
    "command": "python -c 'import playwright; print(\"OK\")'",
    "expected_output": "OK"
  },
  "capabilities": {
    "actions": [
      "run_playwright_test",
      "deploy_playwright_test"
    ],
    "input_formats": [
      "text",
      "json",
      "yaml"
    ],
    "output_formats": [
      "text",
      "json",
      "markdown"
    ]
  },
  "execution": {
    "parallel_safe": true,
    "timeout": 300,
    "memory_gb": 2
  },
  "config": {
    "model": {
      "type": "str",
      "default": "gpt-4o"
    },
    "temperature": {
      "type": "float",
      "default": 0.7
    }
  }
}