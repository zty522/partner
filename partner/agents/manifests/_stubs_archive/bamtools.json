{
  "manifest_version": "1.0.0",
  "name": "bamtools",
  "description": "C++ API and toolkit for BAM files",
  "version": "latest",
  "category": "sequence_processing",
  "domains": [
    "bioinformatics"
  ],
  "install": {
    "command": "conda install -y bamtools",
    "requires_sudo": false,
    "dependencies": []
  },
  "test": {
    "command": "bamtools --help 2>&1 | head -3",
    "expected_output": null
  },
  "capabilities": {
    "actions": [
      "run_bamtools",
      "analyze_with_bamtools"
    ],
    "input_formats": [
      "fasta",
      "fastq",
      "bam",
      "vcf",
      "gff"
    ],
    "output_formats": [
      "tsv",
      "csv",
      "json",
      "html"
    ]
  },
  "execution": {
    "parallel_safe": true,
    "timeout": 3600,
    "memory_gb": 4
  },
  "config": {
    "threads": {
      "type": "int",
      "default": 4
    },
    "verbose": {
      "type": "bool",
      "default": false
    }
  }
}