{
  "manifest_version": "1.0.0",
  "name": "chipseeker",
  "description": "ChIP-seq peak annotation and visualization",
  "version": "latest",
  "category": "epigenetics",
  "domains": [
    "bioinformatics"
  ],
  "install": {
    "command": "conda install -y r-chipseeker",
    "requires_sudo": false,
    "dependencies": []
  },
  "test": {
    "command": "R -e 'library(ChIPseeker); print(\"OK\")' 2>&1 | tail -3",
    "expected_output": null
  },
  "capabilities": {
    "actions": [
      "run_chipseeker",
      "analyze_with_chipseeker"
    ],
    "input_formats": [
      "fasta",
      "fastq",
      "bam",
      "vcf",
      "gff"
    ],
    "output_formats": [
      "tsv",
      "csv",
      "json",
      "html"
    ]
  },
  "execution": {
    "parallel_safe": true,
    "timeout": 3600,
    "memory_gb": 4
  },
  "config": {
    "threads": {
      "type": "int",
      "default": 4
    },
    "verbose": {
      "type": "bool",
      "default": false
    }
  }
}